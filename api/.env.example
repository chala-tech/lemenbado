# Postgres connection string. Local dev or DigitalOcean managed DB.
DATABASE_URL="postgresql://user:password@localhost:5432/lemenbado"

# Signing secret for JWTs — generate a long random string, never commit the real one.
JWT_SECRET="change-me"

# Access token lifetime.
JWT_EXPIRES_IN="15m"

PORT=4000

# Locks CORS to your frontend's origin (Part 11). Update to match how you serve web/.
FRONTEND_ORIGIN="http://localhost:5500"